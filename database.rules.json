{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && auth.token.email == 'diel_zi_nho25@hotmail.com'"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'diel_zi_nho25@hotmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'diel_zi_nho25@hotmail.com')"
      }
    },
    "orders": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null && (auth.token.email == 'diel_zi_nho25@hotmail.com' || (!data.exists() && newData.child('customerUid').val() == auth.uid))"
      }
    }
  }
}
